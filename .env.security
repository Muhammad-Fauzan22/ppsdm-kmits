# ==========================================
# SECURITY CONFIGURATION
# Update your .env.local with these values
# ==========================================

# REQUIRED: Webhook Secret for secure webhook authentication
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=your_secure_random_64_char_hex_string_here

# REQUIRED: Upstash Redis for rate limiting
# Get from: https://upstash.com
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token_here

# RECOMMENDED: CSRF Secret for CSRF token generation
# Generate with: openssl rand -hex 32
CSRF_SECRET=your_csrf_secret_here

# Security headers (optional)
ENABLE_SECURITY_HEADERS=true

# Rate limiting configuration
RATE_LIMIT_STRICT_MAX=5
RATE_LIMIT_STRICT_WINDOW=300000
RATE_LIMIT_STANDARD_MAX=100
RATE_LIMIT_STANDARD_WINDOW=60000

# Audit logging
ENABLE_AUDIT_LOGGING=true
AUDIT_LOG_LEVEL=info
