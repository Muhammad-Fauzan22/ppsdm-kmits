{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": [
    "sin1"
  ],
  "env": {
    "NEXT_PUBLIC_APP_URL": "https://ppsdm-kmits.vercel.app",
    "NEXT_PUBLIC_AI_PROVIDER": "openai",
    "GOOGLE_APPLICATION_CREDENTIALS": "/tmp/credentials.json"
  },
  "build": {
    "env": {
      "NEXT_PUBLIC_APP_URL": "https://ppsdm-kmits.vercel.app"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/dashboard",
      "destination": "/dashboard/overview",
      "permanent": true
    },
    {
      "source": "/assessment",
      "destination": "/dashboard/assessment",
      "permanent": true
    },
    {
      "source": "/reports",
      "destination": "/dashboard/reports",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/google-sheets/:path*",
      "destination": "/api/google-sheets/:path*"
    },
    {
      "source": "/api/automation/:path*",
      "destination": "/api/automation/:path*"
    },
    {
      "source": "/api/reports/:path*",
      "destination": "/api/reports/:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/sync-google-sheets",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/generate-insights",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/send-notifications",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/cleanup-cache",
      "schedule": "0 3 * * 0"
    },
    {
      "path": "/api/cron/sync-campus",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/scrape-knowledge",
      "schedule": "0 */6 * * *"
    }
  ],
  "functions": {
    "app/api/**": {
      "maxDuration": 60
    },
    "app/api/google-sheets/**": {
      "maxDuration": 120
    },
    "app/api/reports/**": {
      "maxDuration": 180
    },
    "app/api/automation/**": {
      "maxDuration": 300
    }
  },
  "git": {
    "deploymentEnabled": {
      "main": true,
      "develop": true
    }
  }
}