# ============================================
# PPSDM KMITS - Production Environment Variables
# ============================================
# Copy this file to .env.production and fill in the values
# DO NOT commit .env.production to version control

# ============================================
# Application Configuration
# ============================================
NEXT_PUBLIC_APP_URL=https://ppsdm-kmits.vercel.app
NEXT_PUBLIC_APP_NAME=PPSDM KMITS
NEXT_PUBLIC_APP_DESCRIPTION=Sistem Manajemen Pengembangan SDM Keluarga Mahasiswa Mesin ITS
NODE_ENV=production

# ============================================
# Google Sheets Integration
# ============================================
# Google Sheets Spreadsheet ID
NEXT_PUBLIC_GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# Google Service Account Credentials (Base64 encoded)
# Use: cat credentials.json | base64 -w 0
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS=your_base64_encoded_credentials_here

# Alternative: Path to credentials file (for local development)
GOOGLE_APPLICATION_CREDENTIALS=/tmp/credentials.json

# ============================================
# Supabase Configuration
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ============================================
# Upstash Redis Configuration
# ============================================
NEXT_PUBLIC_UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# ============================================
# Sentry Error Tracking
# ============================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here
SENTRY_ENVIRONMENT=production

# ============================================
# AI/ML Configuration
# ============================================
# Default AI Provider: openai, groq, google, qwen
NEXT_PUBLIC_AI_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.7

# Groq Configuration
GROQ_API_KEY=gsk_your-groq-api-key-here
GROQ_MODEL=mixtral-8x7b-32768

# Google AI Configuration
GOOGLE_AI_API_KEY=your-google-ai-api-key-here
GOOGLE_AI_MODEL=gemini-pro

# Qwen Configuration
QWEN_API_KEY=your-qwen-api-key-here
QWEN_MODEL=qwen-turbo

# ============================================
# Authentication Configuration
# ============================================
NEXTAUTH_URL=https://ppsdm-kmits.vercel.app
NEXTAUTH_SECRET=your-nextauth-secret-here-generate-with-openssl-rand-base64-32

# ============================================
# Email Configuration (for notifications)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM=noreply@ppsdm-kmits.vercel.app

# ============================================
# Rate Limiting Configuration
# ============================================
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ============================================
# Cache Configuration
# ============================================
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=1000

# ============================================
# File Upload Configuration
# ============================================
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# ============================================
# Feature Flags
# ============================================
NEXT_PUBLIC_ENABLE_AI_FEATURES=true
NEXT_PUBLIC_ENABLE_AUTOMATION=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_REPORTS=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true

# ============================================
# Analytics Configuration
# ============================================
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ============================================
# Social Media Links
# ============================================
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/ppsdmkmits
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/company/ppsdmkmits
NEXT_PUBLIC_YOUTUBE_URL=https://youtube.com/@ppsdmkmits

# ============================================
# Contact Information
# ============================================
NEXT_PUBLIC_CONTACT_EMAIL=contact@ppsdm-kmits.vercel.app
NEXT_PUBLIC_CONTACT_PHONE=+62-31-123-4567
NEXT_PUBLIC_CONTACT_ADDRESS=Gedung PKM ITS, Kampus ITS Sukolilo, Surabaya

# ============================================
# Backup Configuration
# ============================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# ============================================
# Maintenance Mode
# ============================================
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=Sedang dalam pemeliharaan. Silakan coba lagi nanti.

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json

# ============================================
# Security Configuration
# ============================================
CORS_ORIGIN=https://ppsdm-kmits.vercel.app
CSRF_SECRET=your-csrf-secret-here
ENCRYPTION_KEY=your-encryption-key-here-32-bytes-long

# ============================================
# Development/Debug Flags (Set to false in production)
# ============================================
NEXT_PUBLIC_DEBUG_MODE=false
NEXT_PUBLIC_SHOW_ERRORS=false
NEXT_PUBLIC_ENABLE_DEV_TOOLS=false
