import { NextRequest, NextResponse } from 'next/server';
import { createClient } from '@/lib/supabase/server';
import { requireAuth } from '@/lib/auth-cookies';
import { z } from 'zod';
import { sanitizeHtml } from '@/lib/sanitize';

// Validation schemas
const createGroupSchema = z.object({
  name: z.string().min(3).max(100),
  description: z.string().min(10).max(500),
  courseName: z.string().optional(),
  maxMembers: z.number().min(2).max(50).default(10),
  isPrivate: z.boolean().default(false),
  tags: z.array(z.string()).max(5).default([])
});

/**
 * GET /api/study-groups
 * Fetch all study groups for the current user
 */
export async function GET(request: NextRequest) {
  try {
    // Get current user (if authenticated)
    const supabase = await createClient();
    const { data: { user } } = await supabase.auth.getUser();
    
    // Fetch all study groups with member count
    const { data: groups, error } = await supabase
      .from('study_groups')
      .select(`
        *,
        study_group_members!inner(count)
      `)
      .order('created_at', { ascending: false });

    if (error) {
      console.error('[StudyGroups] Error fetching groups:', error);
      return NextResponse.json(
        { error: 'Failed to fetch study groups' },
        { status: 500 }
      );
    }

    // Check which groups the user has joined
    let userGroups: string[] = [];
    if (user) {
      const { data: memberships } = await supabase
        .from('study_group_members')
        .select('group_id')
        .eq('user_id', user.id);
      
      userGroups = memberships?.map(m => m.group_id) || [];
    }

    // Format the response
    const formattedGroups = groups?.map(group => ({
      id: group.id,
      name: sanitizeHtml(group.name),
      description: sanitizeHtml(group.description),
      courseName: group.course_name ? sanitizeHtml(group.course_name) : undefined,
      members: group.study_group_members?.[0]?.count || 0,
      maxMembers: group.max_members,
      isPrivate: group.is_private,
      isJoined: userGroups.includes(group.id),
      tags: group.tags || [],
      createdAt: group.created_at,
      updatedAt: group.updated_at,
    })) || [];

    return NextResponse.json({
      success: true,
      data: formattedGroups
    });

  } catch (error) {
    console.error('[StudyGroups] GET error:', error);
    return NextResponse.json(
      { error: 'Internal server error' },
      { status: 500 }
    );
  }
}

/**
 * POST /api/study-groups
 * Create a new study group
 */
export async function POST(request: NextRequest) {
  try {
    // Authenticate user
    const session = await requireAuth();
    const userId = session.userId;

    const body = await request.json();
    
    // Validate input
    const validatedData = createGroupSchema.parse(body);

    const supabase = await createClient();

    // Create study group
    const { data: group, error: groupError } = await supabase
      .from('study_groups')
      .insert({
        name: validatedData.name,
        description: validatedData.description,
        course_name: validatedData.courseName,
        max_members: validatedData.maxMembers,
        is_private: validatedData.isPrivate,
        tags: validatedData.tags,
        created_by: userId,
        created_at: new Date().toISOString(),
        updated_at: new Date().toISOString()
      })
      .select()
      .single();

    if (groupError) {
      console.error('[StudyGroups] Error creating group:', groupError);
      return NextResponse.json(
        { error: 'Failed to create study group' },
        { status: 500 }
      );
    }

    // Add creator as admin member
    const { error: memberError } = await supabase
      .from('study_group_members')
      .insert({
        group_id: group.id,
        user_id: userId,
        role: 'admin',
        joined_at: new Date().toISOString()
      });

    if (memberError) {
      console.error('[StudyGroups] Error adding creator as member:', memberError);
      // Don't fail the request, but log the error
    }

    // Log audit event
    console.log('[AUDIT] Study group created', {
      userId,
      groupId: group.id,
      groupName: group.name,
      timestamp: new Date().toISOString()
    });

    return NextResponse.json({
      success: true,
      data: {
        id: group.id,
        name: sanitizeHtml(group.name),
        description: sanitizeHtml(group.description),
        courseName: group.course_name ? sanitizeHtml(group.course_name) : undefined,
        members: 1,
        maxMembers: group.max_members,
        isPrivate: group.is_private,
        isJoined: true,
        tags: group.tags || [],
        createdAt: group.created_at,
        updatedAt: group.updated_at
      }
    });

  } catch (error) {
    console.error('[StudyGroups] POST error:', error);
    
    if (error instanceof z.ZodError) {
      return NextResponse.json(
        { error: 'Invalid input', details: error.errors },
        { status: 400 }
      );
    }
    
    if (error instanceof Error && error.message === 'Authentication required') {
      return NextResponse.json(
        { error: 'Authentication required' },
        { status: 401 }
      );
    }
    
    return NextResponse.json(
      { error: 'Internal server error' },
      { status: 500 }
    );
  }
}
