# PPSDM KMM LMS - Environment template
# Copy to `.env.local` and fill values (DO NOT COMMIT `.env.local`)

SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

GOOGLE_AI_KEY=your_google_generative_ai_key_here

# Google Drive Integration
GOOGLE_DRIVE_FOLDER_ID=your_root_folder_id_here
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./config/service-account.json

NEXT_PUBLIC_APP_NAME=PPSDM_KMITS_LMS
NEXT_PUBLIC_DEFAULT_LANGUAGE=en
