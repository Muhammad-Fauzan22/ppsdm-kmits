# ============================================
# Supabase Configuration
# ============================================
# Get these from: https://app.supabase.com/project/_/settings/api

# Cloud (Production/Staging)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key - KEEP SECRET! Never expose in client-side code
# Used only for: Database setup, admin operations, server-side scripts
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Local Development (after running `npx supabase start`)
# Uncomment these to use local Supabase:
# NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs... (from `npx supabase status`)

# ============================================
# AI APIs
# ============================================
# Groq (Primary AI provider) - https://console.groq.com
GROQ_API_KEY=your-groq-api-key

# OpenRouter (Fallback) - https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# ============================================
# Error Tracking (Optional)
# ============================================
# Sentry - https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn

# ============================================
# Caching (Optional)
# ============================================
# Upstash Redis - https://upstash.com
UPSTASH_REDIS_REST_URL=your-upstash-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ============================================
# Backup & Admin (Optional)
# ============================================
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_DB_PASSWORD=your-db-password

# ============================================
# Quick Setup Guide
# ============================================
# 1. Copy this file: cp .env.example .env.local
# 2. Get Supabase credentials from your project dashboard
# 3. Add AI API keys from Groq/OpenRouter
# 4. Run database setup: ./scripts/one_click_setup.sh (Mac/Linux)
#    or: .\scripts\setup_supabase_cli.ps1 (Windows)
# 5. Start dev server: npm run dev
#
# For detailed setup: see SUPABASE_SETUP_GUIDE.md
# For CLI workflow: see SUPABASE_CLI_GUIDE.md
