# Core Database (Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-start-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Intelligence (Brains)
GROQ_API_KEY=your-groq-api-key
OPENAI_API_KEY=your-openai-api-key
GOOGLE_AI_API_KEY=your-google-ai-api-key

# Hugging Face & Other
HUGGINGFACE_API_KEY=your-hf-token
OPENROUTER_API_KEY=your-openrouter-key
REPLICATE_API_TOKEN=your-replicate-token

# Google Integration (Drive & Sheets)
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id
GOOGLE_SHEETS_ID=your-sheet-id
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Monitoring & Error Tracking (Sentry)
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Background Jobs (QStash)
UPSTASH_QSTASH_TOKEN=your-qstash-token
UPSTASH_QSTASH_CURRENT_SIGNING_KEY=your-qstash-signing-key
UPSTASH_QSTASH_NEXT_SIGNING_KEY=your-qstash-next-signing-key

# Search API
SERPAPI_KEY=your-serpapi-key

# App Settings
NEXT_PUBLIC_URL=http://localhost:3000
NODE_ENV=development
ENABLE_AI_CONTENT_GENERATION=true
